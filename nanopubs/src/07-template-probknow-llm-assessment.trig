@prefix this: <http://purl.org/nanopub/temp/np001/> .
@prefix sub: <http://purl.org/nanopub/temp/np001/> .
@prefix np: <http://www.nanopub.org/nschema#> .
@prefix npx: <http://purl.org/nanopub/x/> .
@prefix nt: <https://w3id.org/np/o/ntemplate/> .
@prefix gen: <https://w3id.org/kpxl/gen/terms/> .
@prefix dct: <http://purl.org/dc/terms/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix foaf: <http://xmlns.com/foaf/0.1/> .
@prefix orcid: <https://orcid.org/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix delphi: <https://w3id.org/delphi/ontology/> .
@prefix delphir: <https://w3id.org/delphi/resource/> .
@prefix schema: <https://schema.org/> .

sub:Head {
  this: a np:Nanopublication ;
    np:hasAssertion sub:assertion ;
    np:hasProvenance sub:provenance ;
    np:hasPublicationInfo sub:pubinfo .
}

sub:assertion {
  dct:identifier rdfs:label "has the identifier" .
  delphi:LLMClaimAssessment rdfs:label "LLM claim assessment" .
  delphi:LanguageModel rdfs:label "language model" .
  delphi:evaluatesHypothesis rdfs:label "evaluates the hypothesis" .
  delphi:evidenceAgainst rdfs:label "has evidence against" .
  delphi:evidenceFor rdfs:label "has evidence for" .
  delphi:hasConfidence rdfs:label "has the confidence" .
  delphi:hasProbability rdfs:label "has the probability" .
  delphi:hasVerdict rdfs:label "has the verdict" .
  delphi:usesModel rdfs:label "runs the language model" .
  prov:SoftwareAgent rdfs:label "software agent" .
  prov:wasAttributedTo rdfs:label "is attributed to" .
  rdf:type rdfs:label "is a" .
  rdfs:comment rdfs:label "has the comment" .
  rdfs:label rdfs:label "has the label" .

  <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> a nt:IntroducedResource ;
    rdfs:label "this assessment" .

  sub:label a nt:LiteralPlaceholder ;
    rdfs:label "short label of the assessment" .

  sub:hypothesis a nt:ExternalUriPlaceholder ;
    rdfs:label "the hypothesis being evaluated" ;
    nt:hasPrefix "https://w3id.org/delphi/resource/hypothesis/" ;
    nt:hasPrefixLabel "delphir:hypothesis/" .

  sub:hypothesisLabel a nt:LiteralPlaceholder ;
    rdfs:label "the hypothesis in one sentence" .

  sub:hypothesisCode a nt:LiteralPlaceholder ;
    rdfs:label "the hypothesis code (e.g. H1)" .

  sub:agent a nt:ExternalUriPlaceholder ;
    rdfs:label "the software agent that made the assessment (a language model together with its prompt and scaffolding)" ;
    nt:hasPrefix "https://w3id.org/delphi/resource/agent/" ;
    nt:hasPrefixLabel "delphir:agent/" .

  sub:agentLabel a nt:LiteralPlaceholder ;
    rdfs:label "the agent's name" .

  sub:model a nt:ExternalUriPlaceholder ;
    rdfs:label "the language model the agent ran" ;
    nt:hasPrefix "https://w3id.org/delphi/resource/model/" ;
    nt:hasPrefixLabel "delphir:model/" .

  sub:modelLabel a nt:LiteralPlaceholder ;
    rdfs:label "the model's name and version" .

  sub:modelId a nt:LiteralPlaceholder ;
    rdfs:label "the model's identifier (e.g. its API model id)" .

  sub:probability a nt:LiteralPlaceholder ;
    rdfs:label "probability that the hypothesis is true, from 0 to 1" ;
    nt:hasDatatype xsd:double .

  sub:confidence a nt:LiteralPlaceholder ;
    rdfs:label "the model's confidence in its probability, from 0 to 1" ;
    nt:hasDatatype xsd:double .

  sub:verdict a nt:LiteralPlaceholder ;
    rdfs:label "short categorical verdict (e.g. Plausible)" .

  sub:reasoning a nt:LongLiteralPlaceholder ;
    rdfs:label "the model's reasoning" .

  sub:evidenceFor a nt:LongLiteralPlaceholder ;
    rdfs:label "a point of evidence supporting the hypothesis" .

  sub:evidenceAgainst a nt:LongLiteralPlaceholder ;
    rdfs:label "a point of evidence against the hypothesis" .

  sub:st01 rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
    rdf:predicate rdf:type ;
    rdf:object delphi:LLMClaimAssessment ;
    nt:statementOrder "1" .

  sub:st02 rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
    rdf:predicate rdfs:label ;
    rdf:object sub:label ;
    nt:statementOrder "2" .

  sub:st03 rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
    rdf:predicate delphi:evaluatesHypothesis ;
    rdf:object sub:hypothesis ;
    nt:statementOrder "3" .

  sub:st04 rdf:subject sub:hypothesis ;
    rdf:predicate rdfs:label ;
    rdf:object sub:hypothesisLabel ;
    nt:statementOrder "4" .

  sub:st05 a nt:OptionalStatement ;
    rdf:subject sub:hypothesis ;
    rdf:predicate dct:identifier ;
    rdf:object sub:hypothesisCode ;
    nt:statementOrder "5" .

  sub:st06 rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
    rdf:predicate prov:wasAttributedTo ;
    rdf:object sub:agent ;
    nt:statementOrder "6" .

  sub:st07 rdf:subject sub:agent ;
    rdf:predicate rdf:type ;
    rdf:object prov:SoftwareAgent ;
    nt:statementOrder "7" .

  sub:st08 rdf:subject sub:agent ;
    rdf:predicate rdfs:label ;
    rdf:object sub:agentLabel ;
    nt:statementOrder "8" .

  sub:st09 rdf:subject sub:agent ;
    rdf:predicate delphi:usesModel ;
    rdf:object sub:model ;
    nt:statementOrder "9" .

  sub:st10 rdf:subject sub:model ;
    rdf:predicate rdf:type ;
    rdf:object delphi:LanguageModel ;
    nt:statementOrder "10" .

  sub:st11 rdf:subject sub:model ;
    rdf:predicate rdfs:label ;
    rdf:object sub:modelLabel ;
    nt:statementOrder "11" .

  sub:st12 a nt:OptionalStatement ;
    rdf:subject sub:model ;
    rdf:predicate dct:identifier ;
    rdf:object sub:modelId ;
    nt:statementOrder "12" .

  sub:st13 a nt:OptionalStatement ;
    rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
    rdf:predicate delphi:hasProbability ;
    rdf:object sub:probability ;
    nt:statementOrder "13" .

  sub:st14 a nt:OptionalStatement ;
    rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
    rdf:predicate delphi:hasConfidence ;
    rdf:object sub:confidence ;
    nt:statementOrder "14" .

  sub:st15 a nt:OptionalStatement ;
    rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
    rdf:predicate delphi:hasVerdict ;
    rdf:object sub:verdict ;
    nt:statementOrder "15" .

  sub:st16 a nt:OptionalStatement ;
    rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
    rdf:predicate rdfs:comment ;
    rdf:object sub:reasoning ;
    nt:statementOrder "16" .

  sub:st17 a nt:OptionalStatement, nt:RepeatableStatement ;
    rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
    rdf:predicate delphi:evidenceFor ;
    rdf:object sub:evidenceFor ;
    nt:statementOrder "17" .

  sub:st18 a nt:OptionalStatement, nt:RepeatableStatement ;
    rdf:subject <https://w3id.org/delphi/resource/assessment/~~ARTIFACTCODE~~> ;
    rdf:predicate delphi:evidenceAgainst ;
    rdf:object sub:evidenceAgainst ;
    nt:statementOrder "18" .

  sub:template a nt:AssertionTemplate ;
    rdfs:label "ProbKnow LLM assessment of a hypothesis" ;
    dct:description "An assessment of a ProbKnow hypothesis made by a software agent running a language model as evaluator: the probability that the hypothesis is true, the agent's self-reported confidence, a verdict, its reasoning, and the points of evidence for and against. The agent stands for the model together with its prompt and scaffolding; the model itself is one element of it. The assessment's identifier is minted from this nanopublication's artifact code." ;
    dct:isVersionOf <https://w3id.org/np/RALyOabgB4coZ24ShEqg9VPlg-Kg6_R_9Q-4yfyVV4jRY/llmAssessmentKind> ;
    gen:governedBy <https://w3id.org/spaces/delphi> ;
    nt:hasTag "ProbKnow" ;
    nt:hasTargetNanopubType delphi:LLMClaimAssessment ;
    nt:hasNanopubLabelPattern "${label}" ;
    nt:hasStatement sub:st01, sub:st02, sub:st03, sub:st04, sub:st05, sub:st06, sub:st07, sub:st08, sub:st09, sub:st10, sub:st11, sub:st12, sub:st13, sub:st14, sub:st15, sub:st16, sub:st17, sub:st18 .
}

sub:provenance {
  sub:assertion prov:wasAttributedTo <https://orcid.org/0000-0002-1267-0234> .
}

sub:pubinfo {
  orcid:0000-0002-1267-0234 foaf:name "Tobias Kuhn" .

  this: dct:created "__NOW__"^^xsd:dateTime ;
    dct:creator orcid:0000-0002-1267-0234 ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    rdfs:label "ProbKnow LLM assessment of a hypothesis" ;
    npx:embeds sub:template ;
    npx:introduces <https://w3id.org/np/RALyOabgB4coZ24ShEqg9VPlg-Kg6_R_9Q-4yfyVV4jRY/llmAssessmentKind> ;
    npx:supersedes <https://w3id.org/np/RAku3DINcetdFUnyTLflyV-8ep3QOCuL-IpGdS984vw8s> ;
    skos:changeNote "Ontology 2.0: the assessment is attributed to a prov:SoftwareAgent with prov:wasAttributedTo instead of to a delphi:Model with the now deprecated delphi:assessedBy, and the agent carries the language model it ran as a delphi:LanguageModel reached with delphi:usesModel. Two agents that run the same model with different prompts are thereby distinguishable, which the single delphi:Model node could not express." ;
    nt:wasCreatedFromProvenanceTemplate <https://w3id.org/np/RA7lSq6MuK_TIC6JMSHvLtee3lpLoZDOqLJCLXevnrPoU> ;
    nt:wasCreatedFromPubinfoTemplate <https://w3id.org/np/RAukAcWHRDlkqxk7H2XNSegc1WnHI569INvNr-xdptDGI>, <https://w3id.org/np/RACJ58Gvyn91LqCKIO9zu1eijDQIeEff28iyDrJgjSJF8>, <https://w3id.org/np/RAoTD7udB2KtUuOuAe74tJi1t3VzK0DyWS7rYVAq1GRvw>, <https://w3id.org/np/RAKc76yHLDbloE6ObluzYQsfX37v6qrZXbYeIKpe8-YUo> ;
    nt:wasCreatedFromTemplate <https://w3id.org/np/RAWwJ-TzFhUJN5l6cTUIeCIUqqzS8ek-_zumlDczSUipk/template> .
}
