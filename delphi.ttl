# -- urn: wave --
<urn:pkg:TestableHypothesis>   owl:equivalentClass    delphi:TestableHypothesis .
<urn:pkg:hasPriorProbability>  owl:equivalentProperty delphi:hasPriorProbability .
<urn:pkg:hasResolvability>     owl:equivalentProperty delphi:hasResolvability .
<urn:pkg:proposedTest>         owl:equivalentProperty delphi:proposedTest .
<urn:pkg:hypothesisType>       owl:equivalentProperty delphi:hypothesisType .
<urn:levin-kg:property:domain> owl:equivalentProperty delphi:domain .
npx:hasEvidenceWeight          owl:equivalentProperty delphi:weightOfEvidence .   # not an npx term; one nanopub used it

