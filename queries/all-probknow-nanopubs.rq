# All nanopublications that use any Project Delphi (or legacy ProbKnow) ontology term or resource
# (current delphi slash terms, legacy probknow slash/1.0 hash terms, or delphir: resources).
# Run against the nanopub network SPARQL endpoint, e.g.
#   https://query.knowledgepixels.com/repo/full  (or virtuoso.nps.petapico.org/sparql)
PREFIX delphi: <https://w3id.org/delphi/ontology/>
PREFIX delphir: <https://w3id.org/delphi/resource/>
PREFIX pk_legacy: <https://w3id.org/probknow/ontology/>
PREFIX pkr_legacy: <https://w3id.org/probknow/resource/>
PREFIX np: <http://www.nanopub.org/nschema#>

SELECT DISTINCT ?np WHERE {
  GRAPH ?head { ?np a np:Nanopublication ; np:hasAssertion ?a . }
  GRAPH ?a { ?s ?p ?o . }
  FILTER(
    STRSTARTS(STR(?p), STR(delphi:)) || STRSTARTS(STR(?p), STR(pk_legacy:)) ||
    STRSTARTS(STR(?s), STR(delphir:)) || STRSTARTS(STR(?s), STR(pkr_legacy:)) ||
    (isIRI(?o) && (STRSTARTS(STR(?o), STR(delphi:)) || STRSTARTS(STR(?o), STR(pk_legacy:))))
  )
}
LIMIT 200
